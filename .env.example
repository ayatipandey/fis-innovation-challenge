# Copy to .env and fill in. Never commit real values.

# Node API
PORT=4000
NODE_ENV=development
# Absolute path. Defaults to server/data/perkly.db when unset.
DATABASE_PATH=
SESSION_TTL_DAYS=7
BCRYPT_COST=12

# Python recommendation service (internal; never exposed to the browser)
RECOMMENDER_URL=http://127.0.0.1:8001
# Shared secret between the API and the Python service. Set the same value in the
# environment of both processes for deployment. Leave empty for local development.
RECOMMENDER_SERVICE_KEY=
RECOMMENDER_TIMEOUT_MS=2500

# Future integrations. Not used by the prototype; listed so names are agreed.
PAYMENT_PROVIDER_SECRET_KEY=
APPLE_PAY_MERCHANT_ID=
LOYALTY_PROVIDER_CLIENT_ID=
LOYALTY_PROVIDER_CLIENT_SECRET=
LLM_API_KEY=
