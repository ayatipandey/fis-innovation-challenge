# Copy to .env and fill in. Never commit real values.

# Node API
PORT=4000
NODE_ENV=development
# libSQL. Leave empty locally (uses server/data/perkly.db). On Vercel, the Turso
# integration sets these.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SESSION_TTL_DAYS=7
BCRYPT_COST=10
# Minutes points stay on hold during a redemption.
HOLD_MINUTES=120

# Python AI service (internal). Defaults to http://127.0.0.1:8001 locally and
# /api/ai on the Vercel production URL.
RECOMMENDER_URL=
# Shared secret between the API and the AI service. Same value in both.
RECOMMENDER_SERVICE_KEY=
RECOMMENDER_TIMEOUT_MS=4000
